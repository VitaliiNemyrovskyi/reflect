generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * Non-Player Characters — the supporting cast in a patient's life.
 * Each NPC belongs to ONE character (cascade on character delete) and
 * represents someone in their social/emotional orbit: mother, partner,
 * colleague, best friend, sibling, ex, etc. Used by:
 *
 *   - Chat prompt: injected as a "close people" section so the patient
 *     organically references them ("мама знов дзвонила", "Денис не
 *     дзвонив три дні")
 *   - Memory: feedback can spawn kind='social' memories when an NPC
 *     interaction comes up in session
 *   - 3D network: NPCs render as slate-colored nodes orbiting their
 *     owner character via `knows` edges
 *
 * NPCs are character-wide, NOT user-character scoped — every therapist
 * working with Olesya sees the same mother in her profile. The personal
 * memories about that interaction stay per user-character pair though.
 */
model NPC {
  id          Int       @id @default(autoincrement())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int
  /** Display name — "Мама", "Денис", "Олена з роботи". Free-form so
   *  it can be a nickname / role rather than full name. */
  name        String
  /** Relation slug — drives prompt phrasing ("your mother…", "your
   *  partner…"). Allowed values handled in the service layer:
   *  mother, father, partner, ex, sibling, child, friend, colleague,
   *  boss, neighbor, therapist_prev, other. */
  relation    String
  /** 1-2 sentence prose describing the dynamic — what they're like,
   *  the relationship's tone, current pressures. Goes verbatim into
   *  the chat prompt. */
  bio         String?
  /** Optional avatar URL. If unset, the frontend (network view, future
   *  patient-detail "Близькі" tab) falls back to a DiceBear seed
   *  derived from `name`. */
  avatarUrl   String?
  /** Free-form tags for filtering / context-matching, e.g.
   *  ["supportive","financial-pressure","conflict"]. JSON array. */
  tags        String?
  /** Emotional tension this relationship currently carries, 0..10.
   *  Used by the chat prompt to weight whether to bring this NPC up
   *  spontaneously (high tension → patient mentions them more often).
   *  Default 5 = neutral. Future Phase-4 supervisor extraction may
   *  update this after sessions. */
  tension     Float     @default(5)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([characterId])
}

/**
 * Granular memory entries that constitute a character's lived
 * experience with one specific therapist. Replaces the legacy
 * Session.patientMemory single-string field — that one still gets
 * written for back-compat, but the source of truth for prompt
 * injection is this table.
 *
 * Scoped by (characterId, userId) — different therapists treating the
 * same Anna character have completely independent memory streams. No
 * leakage between them.
 *
 * `kind` categorizes the source:
 *   - 'session'  — what happened during a therapy session (1 per session)
 *   - 'world'    — character's reaction to a news event in their city
 *   - 'social'   — interaction with an NPC (mom called, fight with partner)
 *   - 'diary'    — between-session diary entry generated by Phase-4 cron
 *   - 'seed'     — initial biographical context seeded with the character
 *
 * Retrieval ranks by (weight × recency); the chat prompt typically pulls
 * top-N across kinds so the persona gets a coherent recent-life picture.
 */
model CharacterMemory {
  id          Int       @id @default(autoincrement())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  /** Source session, if this memory comes from one. Null for diary,
   *  world, social, seed kinds. SetNull on delete so memories survive
   *  when a session is discarded. */
  session     Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId   Int?
  kind        String
  /** First-person narrative content, in the character's voice. Injected
   *  verbatim into the chat system prompt (after light grouping). */
  content     String
  /** Importance 0..1 — drives retrieval ranking when assembling the
   *  prompt's memory section. Migrated session memories default to 0.6;
   *  diary defaults to 0.4; world reactions to 0.3. Seed memories can be
   *  set higher to make sure they always surface. */
  weight      Float     @default(0.5)
  /** JSON array of tags for context-matching. Optional. */
  tags        String?
  createdAt   DateTime  @default(now())

  @@index([characterId, userId, createdAt])
  @@index([characterId, userId, kind])
}

/**
 * Shared virtual world that characters live in. Singleton per locale —
 * UA characters share Kyiv, EN characters share London/Edinburgh.
 * The PromptsService.onModuleInit seeds the rows. The news ingester
 * appends NewsItem rows under each city; CityService periodically
 * regenerates `weeklyDigest` — a short LLM summary of recent news +
 * weather that gets injected into every character's chat prompt so
 * patients organically reference what's happening in their city.
 */
model City {
  id              Int       @id @default(autoincrement())
  /** stable lookup key — 'kyiv', 'london', 'edinburgh' */
  key             String    @unique
  /** which locale this city serves — 'uk' or 'en' */
  lang            String
  /** display name shown to users — 'Київ', 'London' */
  displayName     String
  /** ISO 3166 country code for weather APIs etc. — 'UA', 'GB' */
  country         String
  /** Aggregated LLM summary of the past 7d of news, used in every
   *  character's chat system prompt. Plaintext paragraph, no markdown.
   *  Regenerated daily by CityService. null = not yet generated. */
  weeklyDigest    String?
  /** Short weather snapshot. Updated by CityService alongside digest. */
  weatherSummary  String?
  digestUpdatedAt DateTime?
  characters      Character[]
  newsItems       NewsItem[]

  @@index([lang])
}

/**
 * One ingested news article. Fetched from RSS sources (configured in
 * news.service.ts) every hour by NewsService.ingest(). Each gets an
 * LLM summary + topic extraction so the digest step can prioritise.
 * Deduped on (cityId, sourceUrl).
 */
model NewsItem {
  id          Int      @id @default(autoincrement())
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  cityId      Int
  /** RSS source identifier — 'pravda', 'bbc', 'guardian'. */
  source      String
  /** Original article URL — used for dedup and for trace-back. */
  sourceUrl   String
  /** Original headline. */
  title       String
  /** 1-2 sentence LLM rewrite — what a city resident would say if asked
   *  about it casually. Reads as conversational summary, not a headline. */
  summary     String
  /** JSON array of topic tags extracted by LLM, e.g.
   *  ["blackout","energy","kyiv"] — used by character.interests matching
   *  to decide which items each character is "aware of". */
  topics      String
  publishedAt DateTime
  ingestedAt  DateTime @default(now())

  @@unique([cityId, sourceUrl])
  @@index([cityId, publishedAt])
}

model Character {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  displayName    String
  profileText    String
  diagnosis      String?   // Ukrainian-language clinical label shown on UI (truncated to fit cards)
  diagnosisCode  String?   // English DSM-5/ICD code shown as tooltip — for students who want to look up literature
  difficulty     Int?      // 1-5; behavioral difficulty (how hard to engage). Modulates LLM behavior.
  complexity     Int?      // 1-5; clinical severity (how serious the case is). Informational, doesn't change LLM.
  // Therapy modality — drives the skill the trainee is practicing.
  // SQLite has no native enum, so this is a String validated at the
  // service layer (see backend/src/characters/modality.ts). Default
  // 'individual' keeps existing rows in 1-on-1 mode without backfill.
  // Allowed: individual | couples | family | adolescent | crisis.
  modality       String    @default("individual")
  /** Locale this character belongs to. 'uk' = Ukrainian (default),
   *  'en' = English (EU market). Characters API filters by this field
   *  based on the Accept-Language header so UK users see Olesya/Anna
   *  and EN users see Emma/Thomas/Sophie. */
  lang           String    @default("uk")
  /** Patient gender — drives TTS voice selection (male patients get
   *  uk-UA-OstapNeural / en-GB-RyanNeural / fr-FR-HenriNeural; female
   *  patients get the Polina / Sonia / Denise defaults). SQLite has no
   *  native enum so this is a string validated at the service layer.
   *  Allowed: 'female' | 'male'. Nullable: legacy rows may not have it
   *  set; TtsService falls back to the female default when null. */
  gender         String?
  /** Which shared City this character lives in. Drives the news-digest
   *  injection into chat prompts. Optional so legacy rows survive
   *  schema push; service layer fills in based on lang as a fallback. */
  city           City?     @relation(fields: [cityId], references: [id])
  cityId         Int?
  /** Neighborhood/district within city — 'Печерськ', 'Soho'. Surfaced
   *  in prompts so news items about specific neighborhoods can resonate
   *  more strongly for residents. */
  neighborhood   String?
  /** JSON array of topic tags this character cares about, used to
   *  weight which news items make it into their awareness. E.g. an
   *  artist might care about ["culture","exhibitions"] while an IT
   *  worker might track ["energy","blackouts","tech"]. */
  interests      String?
  avatarUrl      String?   // Link to portrait
  // Creator of a user-defined patient. null for system patients (loaded
  // from prompts/profiles/*.md on startup) — these are visible to all
  // users. Non-null = visible only to that user + admins + users in
  // `shares`. PromptsService never touches characters with non-null
  // createdById on startup-sync.
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById    Int?
  createdAt      DateTime  @default(now())
  sessions       Session[]
  // Per-user access grants — owner can share read-access to specific
  // colleagues. Shared users see the patient in their catalog, can run
  // sessions, but cannot edit or delete (those affordances are gated by
  // `createdById === viewer.id` on the frontend).
  shares         CharacterShare[]
  memories       CharacterMemory[]
  npcs           NPC[]

  @@index([createdById])
}

/**
 * Read-access grant from a character's owner to another user. When the
 * owner is deleted (cascades to character) — share goes with it. When
 * the shared-with user is deleted — only the share row is removed, the
 * character stays with its owner.
 */
model CharacterShare {
  id          Int       @id @default(autoincrement())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characterId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  createdAt   DateTime  @default(now())

  @@unique([characterId, userId])
  @@index([userId])
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  hashedPassword  String?  // null for OAuth-only users
  displayName     String?
  bio             String?  // free-text "about me" — year of study, modality interests, etc.
  provider        String   @default("local") // "local" | "google" | "facebook"
  providerUserId  String?  // OAuth subject id
  refreshTokenHash String?
  // Per-user UI preferences serialized as JSON. Schema is loose — clients
  // merge new keys via PATCH. Today: { hintsEnabled: boolean }.
  preferencesJson String?
  // Admin role — bypasses session-ownership checks, sees other users'
  // data, browses error logs. Bootstrapped via ADMIN_EMAILS env var on
  // each login/refresh/me, so granting admin doesn't require manual SQL.
  isAdmin         Boolean  @default(false)
  createdAt       DateTime @default(now())
  sessions        Session[]
  errorLogs       ErrorLog[]
  characters      Character[] // user-created patients
  characterShares CharacterShare[] // patients others have shared with this user
  events          Event[]    // telemetry events (funnel analysis)
  characterMemories CharacterMemory[]  // memory entries per user-character pair
  // Per-user subscription. Optional only at the schema level — every
  // user gets one provisioned on register/oauth-create (default plan
  // = 'trial', trialEndsAt = now + 14 days). Lazy-create fallback in
  // SubscriptionsService.getOrProvision() covers any pre-existing
  // accounts that pre-date the billing rollout.
  subscription    Subscription?
}

/**
 * Per-user billing state. We keep a SINGLE row per user (1:1 via
 * @unique on userId) — when a user upgrades/downgrades/cancels, we
 * mutate this row rather than creating new ones. History (period
 * transitions, payments) lives on separate ledger tables, added when
 * we wire actual payments.
 *
 * Lifecycle:
 *   active   — paid + currentPeriodEnd in future
 *   paused   — user clicked "pause", no charges, no usage; resumesAt
 *              set 1-3 months out
 *   canceled — user clicked "cancel"; access lasts until
 *              currentPeriodEnd, then auto-flips to expired by a
 *              cron sweep (TODO)
 *   expired  — past period end, no renewal — read-only access to
 *              session history, no new sessions
 */
model Subscription {
  id                 Int       @id @default(autoincrement())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int       @unique
  /** plan slug — one of 'trial' | 'lite' | 'pro' | 'master'.
   *  Stored as string (SQLite has no native enum); validated in
   *  SubscriptionsService against PLANS catalog. */
  plan               String
  /** status: 'active' | 'paused' | 'canceled' | 'expired'. */
  status             String    @default("active")
  currentPeriodStart DateTime  @default(now())
  /** End of paid window. For trial = trialEndsAt. After this date,
   *  status transitions to 'expired' unless renewed. */
  currentPeriodEnd   DateTime
  /** Trial-specific cutoff. null for paid plans. */
  trialEndsAt        DateTime?
  /** Set when user cancels; access continues until currentPeriodEnd. */
  canceledAt         DateTime?
  /** Set when user pauses. No usage allowed while paused. */
  pausedAt           DateTime?
  /** Auto-resume target. Null = paused indefinitely. */
  resumesAt          DateTime?
  /** Sessions used in CURRENT period. Resets when currentPeriodEnd
   *  rolls over. Compared against PLANS[plan].sessionLimit. */
  sessionsThisPeriod Int       @default(0)
  /** Admin-only free-form notes (e.g. "voucher Q3-2026", "comped for
   *  university pilot"). Never shown to user. */
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/**
 * Per-event telemetry record. Used for funnel analysis: who hit
 * /demo, who registered, who reached 1st/3rd session, who saw
 * feedback. Lightweight — no PII beyond what's already on User.
 *
 * eventType is a free-form string (validated only against a known
 * set in the controller). props is a JSON-serialized payload — for
 * "session.created" we put characterId, modality; for
 * "pricing.viewed" we put referrer; etc.
 *
 * userId is nullable: pre-registration events (demo/pricing visits
 * from anon browsers) are still recorded, tagged by anonHash.
 *
 * Indexes:
 *   - createdAt for date-range queries (the funnel reads "last 7 days")
 *   - userId for per-user funnel reconstruction
 *   - eventType for type-aggregations
 */
model Event {
  id         Int       @id @default(autoincrement())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     Int?
  /** Stable hash of IP + UA for anonymous-visitor unique counts.
   *  16 hex chars (8 random bytes via crypto.randomBytes seeded from
   *  the actual IP+UA — so repeat visits from the same browser
   *  collide). Null when userId is set (no need to dedupe). */
  anonHash   String?
  eventType  String
  /** JSON payload. Keep small — < 500 chars in practice. */
  props      String?
  sessionId  Int?      // not a FK — sessions can be discarded
  /** Truncated to 200 chars at ingestion. */
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([eventType])
  @@index([anonHash])
}

/**
 * Captured exceptions for admin debugging. Populated by a global
 * NestJS ExceptionFilter — only 500-class server errors (anything that's
 * not a client mistake like 401/403/404/etc.) end up here.
 *
 * userId/sessionId stay nullable so the row survives if those parents
 * are deleted (we set the FK to SetNull instead of cascade — useful
 * when investigating an error that DROPPED a session).
 */
model ErrorLog {
  id         Int       @id @default(autoincrement())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     Int?
  sessionId  Int?      // NOT a FK — sessions can be discarded by users
  endpoint   String    // request path, e.g. /api/sessions/12/end-stream
  method     String    // HTTP method
  status     Int       // HTTP status
  message    String    // truncated to ~500 chars
  stack      String?   // truncated to ~3000 chars; null if not exposed
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Session {
  id              Int       @id @default(autoincrement())
  character       Character @relation(fields: [characterId], references: [id])
  characterId     Int
  user            User?     @relation(fields: [userId], references: [id])
  userId          Int?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  feedback        String?           // Narrative feedback (Markdown)
  feedbackJson    String?           // Structured supervisor JSON (assessment metrics)
  patientMemory   String?           // Anna's first-person memory of this session for next time
  messages        Message[]
  notes           Note[]
  tests           SessionTest[]
  memories        CharacterMemory[]

  @@index([characterId])
  @@index([userId])
}

/**
 * Psychological test administered during a session. The therapist
 * picks a test from the catalog (prompts/tests/*.json), backend asks
 * the AI patient to "take" it staying in character, results are
 * scored + interpreted server-side and surfaced inline in the chat.
 *
 * Status flow: pending → completed (or failed).
 *  - pending: created, waiting for LLM to answer.
 *  - completed: answers parsed, score + severity stored.
 *  - failed: LLM returned unparseable output; row kept for debugging.
 */
model SessionTest {
  id            Int       @id @default(autoincrement())
  session       Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     Int
  testKey       String    // matches `key` in prompts/tests/<key>.json
  status        String    @default("pending") // "pending" | "completed" | "failed"
  answersJson   String?   // [{itemId, value, optionLabel}]
  rawScore      Int?      // sum of item values (post reverse-scoring)
  scaledScore   Int?      // optional scaled score (e.g. WHO-5 ×4)
  severity      String?   // interpretation level key
  severityLabel String?   // human-readable severity (Ukrainian)
  aiAnalysis    String?   // optional supervisor-style interpretation
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?

  @@index([sessionId])
}

model Message {
  id        Int      @id @default(autoincrement())
  // Cascade — when a session is discarded ("як така що не розпочиналась"),
  // all its messages disappear with it. Prevents orphan rows that would
  // otherwise block Session.delete with a FK constraint error.
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId Int
  role      String
  content   String
  createdAt DateTime @default(now())
  notes     Note[]

  @@index([sessionId])
}

model Note {
  id               Int      @id @default(autoincrement())
  // Cascade — same reasoning as Message: a discarded session takes its
  // notes with it.
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId        Int
  // anchorMessage stays nullable + default SetNull on Message delete, so
  // notes referencing a deleted message just lose their anchor (rare path
  // since usually messages only get deleted as part of a session cascade).
  anchorMessage    Message? @relation(fields: [anchorMessageId], references: [id])
  anchorMessageId  Int?
  anchorText       String?
  noteText         String
  createdAt        DateTime @default(now())

  @@index([sessionId])
}

/**
 * Per-call LLM usage + estimated cost. Written fire-and-forget by
 * LlmService after each non-streaming completion (the bulk of token
 * volume: feedback draft + 15 skill agents + diary + world-tick). Gives
 * the admin a spend dashboard and a way to catch runaways (a prompt loop,
 * a model-price surprise) without an external billing integration.
 *
 * Cost is ESTIMATED from a static model→price map in LlmService — exact
 * to within provider price drift, which is fine for visibility. Tokens
 * are the ground truth (straight from the provider response).
 */
model LlmUsage {
  id               Int      @id @default(autoincrement())
  provider         String   // 'anthropic' | 'openrouter'
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([model])
}
