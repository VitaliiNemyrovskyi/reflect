# Кореневий .env — Nest читає його при старті (через @nestjs/config + dotenv)

# Який LLM-провайдер використовуємо: "anthropic" або "openrouter".
# - anthropic: платний, prompt caching, Sonnet 4.6 / Opus 4.7
# - openrouter: безкоштовно (50 req/day, 20 req/min), Qwen3 / NVIDIA NeMotron
LLM_PROVIDER=openrouter

# Anthropic — потрібен лише якщо LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — потрібен лише якщо LLM_PROVIDER=openrouter
# Ключ: https://openrouter.ai/settings/keys (Google-логін, без картки)
OPENROUTER_API_KEY=sk-or-v1-...

# Моделі (опційно — без них візьмуться розумні дефолти для обраного провайдера)
# anthropic дефолти: claude-haiku-4-5 (chat + draft) / claude-opus-4-7 (reviewer)
# openrouter дефолти:
#   chat        = deepseek/deepseek-v4-flash       (1.1s TTFT, $0.10/$0.20)
#   chat fallback = google/gemini-2.5-flash-lite   (різний вендор для надійності)
#   feedback    = openrouter/owl-alpha             (free stealth)
#   fallback    = anthropic/claude-haiku-4-5       (платний бекап)
# LLM_MODEL_CHAT=
# LLM_MODEL_CHAT_FALLBACK=     # auto-retry chat once on timeout/5xx
# LLM_MODEL_FEEDBACK=
# LLM_MODEL_FEEDBACK_FALLBACK=

# ── Feedback pipeline ──────────────────────────────────────────────────────
#
# FEEDBACK_MODE (дефолт: skills)
#   skills   — 14 спеціалізованих Haiku-агентів паралельно + Qwen синтез.
#              Кожен агент фокусується на ONE клінічному вимірі: ризик,
#              сором, когнітивні спотворення, валідація, trauma, невербальні
#              сигнали тощо. ~$0.08/сесія, Opus не потрібен, ~35s до тексту.
#              Файли: prompts/skills/*.md — нові скіли без змін коду.
#   two-pass — Haiku чернетка → tier-based reviewer (Sonnet/Opus).
#              Надійний fallback якщо skills-mode недоступний.
#   single   — legacy одно-прохідний (тільки для дебагу).
#
# FEEDBACK_MODE=skills

# Модель-синтезатор для skills mode (дефолт: qwen/qwen3.7-max на OR).
# Отримує чернетку + JSON всіх агентів → фінальний feedback.
# LLM_MODEL_SKILLS_SYNTHESIZER=qwen/qwen3.7-max

# Reviewer для two-pass mode (дефолт: anthropic/claude-opus-4-7).
# Використовується тільки якщо FEEDBACK_MODE=two-pass.
# LLM_MODEL_FEEDBACK_REVIEWER=anthropic/claude-opus-4-7
# LLM_MODEL_FEEDBACK_REVIEWER_2=qwen/qwen3.7-max  # для ensemble (Master tier)

# ── TTS (озвучка реплік пацієнтів) ─────────────────────────────────────────
#
# У проді ми запускаємо self-hosted sidecar `reflect_tts` (FastAPI у контейнері
# на порту 5050). Він фронтить Google Gemini TTS (primary) + edge-tts (fallback).
#
# TTS_BASE_URL — куди backend стукає. У проді ставиться docker-compose-ом
# у http://reflect_tts:5050. Локально під час dev можна:
#   - залишити порожнім → фронтенд juiltінн на browser SpeechSynthesis
#   - або підняти sidecar окремо: `docker compose -f docker-compose.prod.yml up tts`
TTS_BASE_URL=
#
# GEMINI_API_KEY — ключ з https://aistudio.google.com/apikey (Google-логін, без картки).
# Безкоштовний tier тримає українську набагато природніше за edge-tts Polina.
# Якщо порожньо — sidecar автоматично відкочується на edge-tts.
GEMINI_API_KEY=
#
# Який провайдер пробувати першим у sidecar:
#   - auto    (default): Gemini → edge fallback на помилку
#   - gemini  : Gemini only (502 якщо ключа немає або call впав)
#   - edge    : edge-tts only (legacy шлях)
TTS_PROVIDER=auto
# Модель Gemini для TTS. preview-tts голоси (Aoede, Kore, Leda…) — оптимальний trade-off.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Порт API. Не використовуй PORT — Angular CLI/preview-хост уже використовує цю
# назву для свого dev-server, тому Nest читає API_PORT.
API_PORT=3000

# Prisma + SQLite. Шлях відносно backend/prisma/schema.prisma
DATABASE_URL="file:../reflect.db"

# JWT (обов'язкове). У продакшні згенеруй унікальні: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Google OAuth (опційно — без них кнопка «Login with Google» прихована).
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (опційно). developers.facebook.com → My Apps → Create App
# → Facebook Login → Settings → Valid OAuth Redirect URIs:
#   http://localhost:3000/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Куди редіректити після успішного OAuth-callback'а
FRONTEND_URL=http://localhost:4200
