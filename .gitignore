node_modules/
.env
*.db
*.db-journal
*.db-wal
*.db-shm
.DS_Store

# build output
backend/dist/
frontend/dist/
frontend/.angular/

# Prisma
backend/prisma/migrations/dev.db*

# logs
*.log
npm-debug.log*

# local TTS scratch (OmniVoice app bundle, venv, audio samples — ~1.9GB, never commit)
.tts-bench/

# Claude harness local files (only launch.json should be tracked)
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/worktrees/

# Caddy drop-in vhost configs for sibling projects sharing this ingress.
# Operators drop *.caddy files in deploy/caddy/conf.d/ on the server;
# they're imported by the main Caddyfile but never tracked.
deploy/caddy/conf.d/*.caddy
